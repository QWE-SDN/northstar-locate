# Use Stripe test-mode keys while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Amount is the smallest currency unit: 1999 = USD 19.99.
STRIPE_AMOUNT=1999
STRIPE_CURRENCY=usd
STRIPE_PRODUCT_NAME=Example digital product
# Optional: use an existing Stripe Price ID instead of STRIPE_AMOUNT/STRIPE_CURRENCY.
STRIPE_PRICE_ID=

# Published plans used by the Northstar Locate payment buttons (smallest currency unit).
STRIPE_SINGLE_AMOUNT=90
STRIPE_SINGLE_PRODUCT_NAME=Northstar Locate - Single request
STRIPE_MONTHLY_AMOUNT=1990
STRIPE_MONTHLY_PRODUCT_NAME=Northstar Locate - Monthly plan
# Must be an absolute URL in production.  Leave empty for local development.
PUBLIC_BASE_URL=http://127.0.0.1:4243

# Set this after creating a Stripe webhook endpoint for /webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
HOST=127.0.0.1
PORT=4243

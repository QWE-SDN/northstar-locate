# Whop plan IDs from your Whop dashboard.
WHOP_MONTHLY_PLAN_ID=plan_replace_monthly
WHOP_YEARLY_PLAN_ID=plan_replace_yearly

# Any long random secret used to bind a checkout to the logged-in account.
WHOP_CHECKOUT_SIGNING_SECRET=replace_with_a_long_random_secret

# Whop webhook signing secret for /webhook; keep the complete ws_ value.
WHOP_WEBHOOK_SECRET=ws_replace_me

# Password for https://your-domain.example/admin.
ADMIN_PASSWORD=replace_with_a_long_admin_password

# Enable verified registration after configuring a verified Resend domain and API key.
EMAIL_VERIFICATION_REQUIRED=false
RESEND_API_KEY=
EMAIL_FROM=Northstar Locate <verify@northstarlocate.com>

# Use a Render persistent disk path in production, for example /var/data/northstar.sqlite3.
DATABASE_PATH=./data/northstar.sqlite3

# Used to decide whether the session cookie needs the Secure flag.
PUBLIC_BASE_URL=http://127.0.0.1:4243
HOST=127.0.0.1
PORT=4243
